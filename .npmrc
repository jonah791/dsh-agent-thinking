# @deepseek-ai/* are provided by the DSH runtime; link them from the host checkout for type resolution.
# pnpm 9 uses camelCase keys; pnpm 11 needs verify-deps-before-run=false (deps are host-provided).
autoInstallPeers=false
auto-install-peers=false
strict-peer-dependencies=false
verify-deps-before-run=false
